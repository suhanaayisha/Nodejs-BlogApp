@layout('layouts.app')

@section('content')
<header class="masthead">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <div class="page-heading">
            <h1>Share a Recipe</h1>
            <span class="subheading">What have you been cooking?</span>
          </div>
        </div>
      </div>
    </div>
  </header>

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            @if(errors.length > 0)
                <ul class="list-group mb-4">
                    @each(error in errors)
                        <li class="list-group-item text-danger">{{ error }}</li>
                    @endeach
                </ul>
            @endif
            <form class="recipe-form" action="/recipes" method="POST" enctype="multipart/form-data">

                <div class="control-group">
                    <div class="form-group floating-label-form-group controls">
                        <label>Recipe name</label>
                        <input type="text" name="title" value="{{ data.title || '' }}" class="form-control" placeholder="Recipe name">
                    </div>
                </div>
                <div class="control-group">
                    <div class="form-group floating-label-form-group controls">
                        <label>Short description</label>
                        <input type="text" name="description" value="{{ data.description || '' }}" class="form-control" placeholder="Short description, e.g. A quick weeknight curry">
                    </div>
                </div>

                <div class="form-row mt-4">
                    <div class="form-group col-4">
                        <label for="prepTime">Prep time (min)</label>
                        <input type="number" min="0" id="prepTime" name="prepTime" value="{{ data.prepTime || '' }}" class="form-control">
                    </div>
                    <div class="form-group col-4">
                        <label for="cookTime">Cook time (min)</label>
                        <input type="number" min="0" id="cookTime" name="cookTime" value="{{ data.cookTime || '' }}" class="form-control">
                    </div>
                    <div class="form-group col-4">
                        <label for="servings">Servings</label>
                        <input type="number" min="1" id="servings" name="servings" value="{{ data.servings || '' }}" class="form-control">
                    </div>
                </div>

                <div class="form-group mt-4">
                    <label for="ingredients">Ingredients</label>
                    <textarea rows="8" class="form-control" id="ingredients" name="ingredients" placeholder="2 cups flour&#10;1 tsp salt&#10;3 eggs">{{ data.ingredients || '' }}</textarea>
                    <small class="form-hint">One ingredient per line</small>
                </div>
                <div class="form-group mt-4">
                    <label for="steps">Method</label>
                    <textarea rows="10" class="form-control" id="steps" name="steps" placeholder="Preheat the oven to 180°C&#10;Mix the dry ingredients&#10;...">{{ data.steps || '' }}</textarea>
                    <small class="form-hint">One step per line, in order</small>
                </div>

                <div class="form-group mt-4">
                    <label for="image">Photo of the dish</label>
                    <input type="file" id="image" name="image" accept="image/*" class="form-control-file">
                </div>
                <div class="form-group my-4 text-center">
                    <button class="btn btn-primary">
                        Publish Recipe
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@endsection
